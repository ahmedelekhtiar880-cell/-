<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دعوة زفاف - Mohamed & Rawan</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&family=Reem+Kufi:wght@600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
            padding: 20px;
        }
        .card {
            background: rgba(255, 255, 255, 0.95);
            padding: 40px 20px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            max-width: 450px;
            width: 100%;
            border: 2px solid #e0c3fc;
            position: relative;
        }
        h1 {
            font-family: 'Reem Kufi', sans-serif;
            color: #8e44ad;
            font-size: 2.2rem;
            margin-bottom: 10px;
        }
        p { font-size: 1.1rem; color: #555; margin-bottom: 15px; }
        .date {
            font-weight: bold;
            color: #2c3e50;
            font-size: 1.3rem;
            margin: 20px 0;
        }
        .timer {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
        }
        .timer div {
            background: #8e44ad;
            color: white;
            padding: 10px;
            border-radius: 8px;
            min-width: 60px;
        }
        .timer span { display: block; font-size: 0.8rem; }
        .btn {
            display: inline-block;
            background: #27ae60;
            color: white;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            margin-top: 15px;
            transition: 0.3s;
            border: none;
            cursor: pointer;
        }
        .btn:hover { background: #219150; transform: scale(1.05); }
    </style>
</head>
<body>

    <div class="card">
        <p>يسرنا دعوتكم لحضور حفل زفاف</p>
        <h1>محمد & روان</h1>
        <p>❦</p>
        
        <div class="date">الخميس، 3 سبتمبر 2026</div>

        <div class="timer">
            <div><strong id="days">00</strong><span>يوم</span></div>
            <div><strong id="hours">00</strong><span>ساعة</span></div>
            <div><strong id="minutes">00</strong><span>دقيقة</span></div>
            <div><strong id="seconds">00</strong><span>ثانية</span></div>
        </div>

        <a href="https://maps.google.com" target="_blank" class="btn">📍 موقع القاعة (Google Maps)</a>
    </div>

    <script>
        const weddingDate = new Date("Sept 3, 2026 19:00:00").getTime();
        setInterval(function() {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            document.getElementById("days").innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
            document.getElementById("hours").innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById("minutes").innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById("seconds").innerText = Math.floor((distance % (1000 * 60)) / 1000);
        }, 1000);
    </script>
</body>
</html>
